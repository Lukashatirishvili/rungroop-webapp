<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CloudinaryDotNet" Version="1.29.1" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.3" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.3" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.3">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="RunGroop.Application\obj\project.assets.json" />
      <_ContentIncludedByDefault Remove="RunGroop.Application\obj\project.packagespec.json" />
      <_ContentIncludedByDefault Remove="RunGroop.Application\obj\RunGroop.Application.csproj.nuget.dgspec.json" />
      <_ContentIncludedByDefault Remove="RunGroop.Infrastructure\obj\project.assets.json" />
      <_ContentIncludedByDefault Remove="RunGroop.Infrastructure\obj\project.packagespec.json" />
      <_ContentIncludedByDefault Remove="RunGroop.Infrastructure\obj\RunGroop.Infrastructure.csproj.nuget.dgspec.json" />
    </ItemGroup>

</Project>
